# Copie para .env e ajuste os valores. Nunca versione o .env.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./kg.db
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

# Login do painel. O usuário é criado na primeira vez que a API sobe.
ADMIN_EMAIL=katiuschia@kgsaude.com.br
ADMIN_PASSWORD=troque-esta-senha

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo

# Cobrança do sinal:
#   fake          → Pix simulado (desenvolvimento; botão "simular pagamento" no checkout)
#   mercado_pago  → Pix real com confirmação automática
#   manual        → chave Pix fixa + comprovante no WhatsApp, confirmado no painel
PAGAMENTO_PROVEDOR=fake
PAGAMENTO_EXPIRA_MINUTOS=30

# Mercado Pago → Suas integrações → (aplicação) → Credenciais de produção
MERCADO_PAGO_ACCESS_TOKEN=
# Mercado Pago → Suas integrações → (aplicação) → Webhooks → Assinatura secreta
MERCADO_PAGO_WEBHOOK_SECRET=
# Endereço público do site (https). Com ele o Mercado Pago avisa os pagamentos por webhook.
URL_PUBLICA=
